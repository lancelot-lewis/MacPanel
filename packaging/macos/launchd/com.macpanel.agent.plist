<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MacPanel — Root Agent 的 launchd 服务定义。

  安装位置：/Library/LaunchDaemons/com.macpanel.agent.plist
  运行身份：root（需要读取 /dev/pf、未来需要执行 pfctl 与 launchctl）
  启动时机：系统启动即运行，不依赖用户登录

  注意：本文件是模板，安装脚本会用实际路径替换 __BINARY_PATH__ 与 __LOG_DIR__。
  未经实机验证前，不要把它设为开机强制启用。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.macpanel.agent</string>

	<key>ProgramArguments</key>
	<array>
		<string>__BINARY_PATH__</string>
		<string>agent</string>
	</array>

	<!-- 环境：显式给出全部路径，避免继承不确定的环境变量 -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>MACPANEL_SOCKET_PATH</key>
		<string>/var/run/macpanel/agent.sock</string>
		<key>MACPANEL_TOKEN_PATH</key>
		<string>/Library/Application Support/MacPanel/ipc.token</string>
		<key>MACPANEL_DATA_DIR</key>
		<string>/Library/Application Support/MacPanel/data</string>
		<key>MACPANEL_LOG_DIR</key>
		<string>__LOG_DIR__</string>
		<key>MACPANEL_ANCHOR_PATH</key>
		<string>/etc/pf.anchors/com.macpanel.ipv6</string>
		<key>MACPANEL_LOG_LEVEL</key>
		<string>info</string>
		<!--
			Server 以 _macpanel 身份连接本 Agent 的 IPC，而 ipc.UIDAllowed 只放行
			「与 Agent 同 euid（root=0）」或这里显式列出的 UID。
			_macpanel 的 UID 是安装时动态分配的（从 350 起找空位），
			因此不能写死在模板里，由 postinstall 用实际 UID 替换 __SERVER_UID__。
		-->
		<key>MACPANEL_ALLOWED_PEER_UIDS</key>
		<string>__SERVER_UID__</string>
		<!--
			Agent 把 Socket 文件（0660，root 创建）的属组改成这个 GID，
			否则 _macpanel 组的 Server 连不上 Socket（默认组是 wheel）。
		-->
		<key>MACPANEL_SOCKET_GID</key>
		<string>__SERVER_GID__</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- 异常退出后重启；限流避免崩溃循环拖垮系统 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<!-- 日志 -->
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/agent.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/agent.stderr.log</string>

	<!-- 权限：以 root 运行 -->
	<key>UserName</key>
	<string>root</string>
	<key>GroupName</key>
	<string>wheel</string>

	<!-- 资源限制：防止异常情况下耗尽系统 -->
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>256</integer>
	</dict>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>128</integer>
	</dict>

	<!-- 进程类型：后台常驻 -->
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
